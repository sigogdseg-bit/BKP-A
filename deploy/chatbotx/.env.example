# ─────────────────────────────────────────────────────────────────────────────
# SIGO GUARDIÃO — VARIÁVEIS DE AMBIENTE DO CHATBOTX (MICROSSERVIÇO)
# Copie este arquivo para .env no servidor: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Domínio público ou IP onde o ChatbotX responderá (ex: https://chat.hunter.oficial.tec.br)
CHATBOTX_PUBLIC_URL=https://chat.hunter.oficial.tec.br
CHATBOTX_DOMAIN=chat.hunter.oficial.tec.br

# Chaves Criptográficas (Gere novas chaves seguras com: openssl rand -base64 32 ou openssl rand -hex 32)
BETTER_AUTH_SECRET=alterar_para_uma_chave_aleatoria_base64_32_bytes==
ENCRYPTION_KEY=alterar_para_64_caracteres_hexadecimais_0123456789abcdef0123456789abcdef
REALTIME_API_KEY=hunter_realtime_secret_key_producao
REALTIME_BROADCAST_SECRET=alterar_para_64_caracteres_hexadecimais_broadcast_0123456789abcdef
JAVASCRIPT_EXECUTOR_TOKEN=token_com_pelo_menos_32_caracteres_para_sandbox_js

# Banco de Dados TimescaleDB (PostgreSQL)
POSTGRES_DB=chatbotx
POSTGRES_USER=chatbotx_hunter
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui_para_o_banco

# Storage S3 Local (RustFS)
RUSTFS_ACCESS_KEY=chatbotx_minio_user
RUSTFS_SECRET_KEY=defina_uma_senha_forte_storage_s3

# Integração com o SIGO Guardião
# Token secreto compartilhado para validar webhooks recebidos do Hunter
HUNTER_WEBHOOK_SECRET=hunter_guardiao_webhook_secret_2026

# Chaves de IA (Opcional - OpenAI / Anthropic / Google Gemini para os Agentes do ChatbotX)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

{
  "name": "hunter-whatsapp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Micro-gateway ultra-leve de WhatsApp Baileys para o SIGO Guardião (Fly.io Free Tier 256MB)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "postinstall": "node scripts/patch-baileys.mjs",
    "test": "node --test --experimental-test-module-mocks tests/*.test.mjs",
    "start": "node --max-old-space-size=180 dist/server.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.24",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
